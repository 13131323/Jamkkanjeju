{
  "expo": {
    "name": "잠깐제주",
    "slug": "tamnalog",
    "owner": "tamnalogs-team",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "찾은 보물과 찍은 사진을 앨범에서 보여드리기 위해 접근 권한이 필요해요.",
        "NSPhotoLibraryAddUsageDescription": "캐릭터와 함께 찍은 사진을 갤러리에 저장하려면 권한이 필요해요.",
        "NSCameraUsageDescription": "보물을 찾기 위해 카메라로 주변을 비춰야 해요.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use your microphone"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_HEALTH"
      ],
      "package": "com.tamnalog.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "https",
              "host": "jankkan-jeju-web.azurewebsites.net",
              "pathPrefix": "/cooperative-missions/invite"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "보물을 찾으려면 내 위치와 방향을 확인해야 해요. 위치 권한을 허용하면 주변 500m 안의 보물을 알려드릴게요.",
          "locationAlwaysAndWhenInUsePermission": "앱을 보고 있지 않을 때도 다녀온 장소를 기록하려면 위치 권한이 '항상'이어야 해요.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "보물을 찾기 위해 카메라로 주변을 비춰야 해요.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "찾은 보물과 찍은 사진을 앨범에서 보여드리기 위해 접근 권한이 필요해요.",
          "savePhotosPermission": "캐릭터와 함께 찍은 사진을 갤러리에 저장하려면 권한이 필요해요.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo"]
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "tamnalog",
          "project": "tamnalog-app"
        }
      ],
      "expo-background-task",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#FFFFFF",
          "enableFullScreenImage_legacy": true,
          "android": {
            "image": "./assets/splash-icon.png",
            "imageWidth": 100
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "tamnalog",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dccfafdf-ae78-44e5-abc9-385cb75692f3"
      }
    }
  }
}
