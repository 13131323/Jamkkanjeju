{
  "name": "@tamnalog/app",
  "version": "0.0.1",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo prebuild --clean --platform android && expo run:android",
    "android:device": "node scripts/run-android-device.js",
    "ios": "expo prebuild && expo run:ios",
    "prebuild": "expo prebuild",
    "build:android": "pnpm build:store",
    "build:preview": "eas env:exec preview \"npx eas-cli build --platform android --profile preview\"",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "generate": "orval",
    "build:store": "eas env:exec production \"npx eas-cli build --platform android --profile production\"",
    "build:apk": "eas env:exec production \"npx eas-cli build --platform android --profile production-apk\""
  },
  "dependencies": {
    "@expo/dom-webview": "56.0.6",
    "@packages/shared": "workspace:*",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/react-query": "^5.101.0",
    "axios": "^1.17.0",
    "expo": "~56.0.21",
    "expo-background-task": "~56.0.27",
    "expo-camera": "~56.0.8",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.25",
    "expo-dev-client": "~56.0.26",
    "expo-file-system": "~56.0.11",
    "expo-font": "~56.0.7",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.17",
    "expo-location": "~56.0.25",
    "expo-media-library": "~56.0.11",
    "expo-network": "~56.0.5",
    "expo-router": "~56.2.20",
    "expo-splash-screen": "~56.0.15",
    "expo-sqlite": "~56.0.6",
    "expo-status-bar": "~56.0.4",
    "expo-task-manager": "~56.0.27",
    "expo-web-browser": "~56.0.6",
    "nativewind": "^4.1.23",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-step-counter-newarch": "^0.5.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.2",
    "react-native-webview": "13.16.1",
    "zod": "^3.25.51",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "babel-preset-expo": "~56.0.0",
    "eas-cli": "^23.1.0",
    "eslint": "^9",
    "eslint-config-expo": "~56.0.4",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "expo-font": "~56.0.7"
  }
}
