EXPO_PUBLIC_API_URL=http://localhost:8000

# 배포용 web 주소. EAS production에는 실제 공개 HTTPS 도메인을 등록해야 한다
# (app.config.ts가 production 빌드에서 HTTPS·공개 도메인 여부를 검증한다).
EXPO_PUBLIC_WEB_URL=https://app.example.com

# 개발용 web 주소. EXPO_PUBLIC_WEB_URL이 없을 때 dev 빌드가 이 값으로 폴백한다.
# 코드에 기본값을 두지 않으므로 개발 시 반드시 필요하다.
#   - Android 에뮬레이터: http://10.0.2.2:3000
#   - USB 실기기(pnpm dev:app, adb reverse): http://127.0.0.1:3000
# pnpm dev:app이 이 값을 읽어 adb reverse 포트와 Next.js dev 서버 포트까지 맞춘다.
EXPO_PUBLIC_DEV_WEB_URL=http://127.0.0.1:3000

EXPO_PUBLIC_SENTRY_DSN=
