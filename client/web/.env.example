NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_KAKAO_MAP_KEY=put-your-kakao-map-key-here

# Sentry를 사용할 때만 입력합니다.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# 로컬 개발 서버에서 추가로 허용할 origin이 있을 때만 입력합니다.
ALLOWED_DEV_ORIGIN=

# [dev 전용] 배포 API를 로컬에서 볼 때만 채웁니다(예: /dev-api).
# 앱 WebView가 web을 http://localhost:3000에서 읽는데 배포 서버 CORS 목록에 그 origin이 없어
# 브라우저가 응답을 버립니다. 이 값을 채우면 Next가 대신 전달해 same-origin으로 통신합니다.
NEXT_PUBLIC_API_PROXY_PATH=
# 심사위원용 모드 진입 코드(6자, 영문은 대문자로 비교). 비우면 어떤 코드로도 열리지 않는다.
NEXT_PUBLIC_JUDGE_MODE_CODE=
