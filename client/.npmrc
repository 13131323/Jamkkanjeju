# Windows MAX_PATH(260자) 제한 해결: pnpm global store를 짧은 경로에 위치
store-dir=C:/pnpm-store

# 가상 스토어 디렉토리명 최대 길이 제한 (Windows 경로 초과 방지)
virtual-store-dir-max-length=120

# flat node_modules - React Native Gradle이 가상 스토어 해시 경로 못 찾는 문제 해결
node-linker=hoisted


# peer dependencies 자동 설치
auto-install-peers=true
